<div class="container my-5">
    <h2 class="text-center mb-4 text-dark fw-bold">Customer Reviews</h2>
    
    <!-- g-4 adds vertical and horizontal gap between rows/columns -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        
 

        <!-- Review Box 2 -->
 <% for(arr of list.reviews){ %>
        <div class="col">
            <div class="card h-100 shadow-sm border-0 bg-white">

                <div class="card-body p-4">
                      <p class="card-text text-muted"><%= arr.author.username %> </p>
                      <p class="card-text text-muted"><%= arr.comment%> </p>

                    <% if(currUser && currUser._id.equals(arr.author._id)) {%>
                      <a href="/listings/delete/<%=list._id%>/review/<%= arr._id %>" class="btn btn-danger">delete</a>
                    <% } %>    

                </div>

                <div class="card-footer bg-transparent border-0 pt-0 pb-4 px-4 d-flex align-items-center">
                </div>
            </div>
        </div>
  <% } %>
 


    </div>
</div>









 