<% layout('layouts/boilerplate.ejs') -%>


<div class="card" style="width: 18rem; width: 50%; margin: 0 auto; margin-top: 1pc;">
  <img src="<%= list.image.url %> " class="card-img-top" alt="image not found">
  <div class="card-body">
   <i><p class="card-text"><%= list.owner.username %> </p></i> <br>
    <h5 class="card-title"><%= list.title %></h5>
    <p class="card-text"><%= list.description %> </p>
    <p class="card-text"><%= list.location %> </p>
    <p class="card-text"><%= list.country %> </p>
    <p class="card-text">&#8377; <%=list.price.toLocaleString("en-IN")%>/night</p>


<% if(currUser && currUser._id.equals(list.owner._id)) {%>
  <a href="/listings/edit/<%=list._id%>" class="btn btn-primary">Edit Listing</a>
<form method="post" action="/listings/delete/<%=list._id%>?_method=DELETE" style="display: inline;">
    <button class="btn btn-danger">Delete Listing</button>
</form> 
 <% } %>
 
  </div>
</div>

 
