 
<% layout('/layouts/boilerplate.ejs') -%>


     <!-- Main Content (Cards)  -->
     <main class="container">
        <div class="card-grid">
            <% for(listing of listings){ %>
            <div class="card">
                <div class="card-img">
                <a href="/listings/view/<%=listing._id%>"><img src= <%= listing.image.url %> alt="not found" style="width: 100%; height: 100%;"></a>
                </div>
                <div class="card-body">
                    <h3><%= listing.title %></h3>
                    <p>&#8377; <%=listing.price.toLocaleString("en-IN")%>/night</p>
                    <!-- <button class="btn">Read More</button> -->
                    <!-- <button class="btn"><a style="text-decoration: none;" href="/listings/view/<%=listing._id%>" >Read More</a></button> -->

                </div>
            </div> 
            <% } %>
       </div>
    </main>


 